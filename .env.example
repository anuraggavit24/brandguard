# Copy to .env and fill in. Never commit real secrets.

# Optional: hosted speech recognition + optional AI rewrite / AI review / lessons.
# Paste-copy demos, Brand Risk Radar, counterfactual rewrites, claim provenance and
# Guideline Health all work WITHOUT this key (offline / heuristic paths).
# Get a free key at https://console.groq.com/
GROQ_API_KEY=

# Sign session cookies. Use a long random string in any shared or hosted deploy.
SECRET_KEY=change-me-for-any-shared-deploy

# Speech: groq (default, needs GROQ_API_KEY) or local (needs faster-whisper installed).
TRANSCRIBE_MODE=groq
# LOCAL_MODEL=medium

# Optional model overrides for text AI (rewrite, review, lessons). Defaults are set in llm.py.
# AI_MODEL=
# AI_FALLBACK_MODEL=
# REWRITE_MODEL=
# AI_REVIEW_DAILY_CAP=200

# On-screen text (video frames). Set OCR_ENABLED=0 to skip.
OCR_ENABLED=1
# OCR_FPS=2
# OCR_BUDGET=75
# OCR_WORKERS=3
# OCR_LANGS=eng+hin+mar
# TESSERACT_CMD=

# Link fetch (YouTube/Instagram/Facebook). Usually off on cloud hosts.
LINKS_ENABLED=1

# Where SQLite and uploads live.
DATA_DIR=data

# Keep uploaded files after review (default deletes them; hash is still stored).
# KEEP_UPLOADS=0

PORT=8000

# Email (invites, password reset, results). Brevo works on Render's free plan (300 emails/day free).
# BREVO_API_KEY=
# MAIL_FROM=you@example.com        (a sender verified in Brevo)
# MAIL_FROM_NAME=BrandGuard
# Or SMTP where outgoing email ports are open (not Render free):
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD=

# Public address of this site, used in links inside emails.
# PUBLIC_URL=https://your-app.onrender.com

# Limits and security
# RESET_COOLDOWN_MIN=10
# INVITES_PER_DAY=100
# UPLOADS_PER_HOUR=30
