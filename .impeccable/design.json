  "narrative": {
    "northStar": "The Violet Ledger",
    "overview": "BrandGuard reads like a clear page of accounts: every verdict is a number you can check, a chip that names it, and a chart that puts it in context. The workspace is a grid of rounded white cards on a pale lavender ground, with one saturated violet that appears in three places only: the main action, the current place, and the single headline figure on each dashboard.",
    "keyCharacteristics": [
      "Bento grid of 16px-radius cards; one gradient hero tile per dashboard.",
      "Big, tabular, heavy numerals over small quiet labels.",
      "Rings, bars and columns drawn from real submission data; never decorative.",
      "Status shown by a chip with icon and word, never by colour alone.",
      "Light by default, dark on request or by system setting."
    ],
    "rules": [
      {
        "name": "The One Violet Rule",
        "body": "Violet marks the action, the place you are, and the one headline figure. It never decorates.",
        "section": "colors"
      },
      {
        "name": "The Status-Only Colour Rule",
        "body": "Green, amber and red mean a verdict and nothing else.",
        "section": "colors"
      },
      {
        "name": "The Real-Data Rule",
        "body": "A chart only ever shows counts from the company's own submissions; there is no sample or placeholder data in a chart.",
        "section": "colors"
      },
      {
        "name": "The Plain Sentence Rule",
        "body": "Findings and statuses are plain sentences in sentence case. Uppercase belongs to table headers and group names.",
        "section": "typography"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "Surfaces carry no shadow beyond the hairline until they float or are hovered.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep violet to the action, the current place and the hero figure.",
      "Do draw every chart from real counts, with a text equivalent.",
      "Do pair every status colour with an icon and a word.",
      "Do keep controls at 44px and focus outlines visible.",
      "Do keep sizes, radii and colours on the defined scales and tokens so the dark theme works.",
      "Do scope single-key shortcuts to focus inside the control group (WCAG 2.1.4)."
    ],
    "donts": [
      "Don't use green, amber or red for decoration, or add a second accent hue.",
      "Don't put thick coloured edges on cards or nest a bordered card inside another card.",
      "Don't show sample or invented numbers in a chart or stat tile.",
      "Don't use heavy shadows on resting cards.",
      "Don't convey a verdict by colour alone."
    ]
  }
